//dependency dev.langchain4j:langchain4j-mcp:1.12.2-beta22

import dev.langchain4j.mcp.client.*;
import dev.langchain4j.agent.tool.*;
import dev.langchain4j.mcp.client.transport.*;
import dev.langchain4j.mcp.client.transport.http.*;
import dev.langchain4j.mcp.client.transport.websocket.*;
import dev.langchain4j.model.chat.request.json.*;
import com.fasterxml.jackson.databind.ObjectMapper;
import java.io.IOException;

import id.xfunction.cli.CommandOptions;

if (args.length == 0) {
    cli.printerr("""
