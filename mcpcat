}

var objectMapper = new ObjectMapper();
var options = CommandOptions.collectOptions(args);

String pretty(String json) {
    try {
        var obj = objectMapper.readValue(json, Object.class);
        return objectMapper.writerWithDefaultPrettyPrinter().writeValueAsString(obj);
    } catch (IOException e) {
        return json;
    }
}

McpTransport createTransport(String mcpUrl) {
    var connTimeout = Duration.ofSeconds(
            options.getOptionInt("connTimeoutInSecs").orElse(10));
    var logRequests = options.isOptionTrue("logRequests");
    var logResponses = options.isOptionTrue("logResponses");
    Map<String, String> headers = Map.of();

    if (mcpUrl.endsWith("/sse")) {
        return new HttpMcpTransport.Builder()
            .sseUrl(mcpUrl)
            .customHeaders(headers)
            .logRequests(logRequests)
            .logResponses(logResponses)
            .timeout(connTimeout)
            .build();
    } else if (mcpUrl.startsWith("ws://")) {
        return new WebSocketMcpTransport.Builder()
            .url(mcpUrl)
            .logRequests(logRequests)
            .logResponses(logResponses)
            .timeout(connTimeout)
            .build();
    }

    StreamableHttpMcpTransport.Builder builder = new StreamableHttpMcpTransport.Builder()
        .url(mcpUrl)
        .customHeaders(headers)
        .logRequests(logRequests)
        .timeout(connTimeout)
        .logResponses(logResponses);

    if (options.isOptionTrue("useHttpV1_1")) {
        builder.setHttpVersion1_1();
    }

    return builder.build();
}

var transport = createTransport(options.getRequiredOption("mcpUrl"));
var client = new DefaultMcpClient.Builder()
    .autoHealthCheck(false)
    .toolExecutionTimeout(Duration.ofSeconds(options.getOptionInt("toolExecutionTimeoutInSecs").orElse(60*10)))
    .transport(transport)
    .build();

String bold(String str) {
    return "\033[1m" + str + "\033[0m";
}

String asString(JsonObjectSchema spec) {
    return """
        %s %s
        %s %s
        %s
        %s
        """.formatted(bold("Required:"),
            spec.required(),
            bold("Description:"),
            spec.description(),
            bold("Properties:"),
        spec.properties().entrySet().stream().map(e -> "%s\n %s".formatted(e.getKey(), e.getValue())).collect(joining("\n")));
}

String asString(ToolSpecification spec) {
    return """
        %s %s
        %s %s
        %s
        %s
        """.formatted(bold("Name:"),
            spec.name(),
            bold("Description:"),
            spec.description(),
            bold("Parameters:"),
            asString(spec.parameters()));
}

void teeToFile(String name) {
    options.getOption("output").map(Path::of)
        .ifPresent(p -> {
            var outputFile = p.resolve(name);
            cli.print("Forward output to " + outputFile);
            Unchecked.run(() -> Files.createDirectories(outputFile.getParent()));
            cli.teeToFile(outputFile);
        });
}

void listTools(String toolNameRegexp) {
    teeToFile("listTools");
    client.listTools().stream()
        .filter(spec -> spec.name().matches(toolNameRegexp))
        .map(spec -> asString(spec)).forEach(cli::print);
}

void callTool(String name, String arguments) throws IOException {
    teeToFile(name);
    if (!arguments.isEmpty() && arguments.charAt(0) == '@') {
        arguments = Files.readString(Path.of(arguments.substring(1).replaceFirst("^~", System.getProperty("user.home"))));
    }
    var result = client.executeTool(ToolExecutionRequest.builder()
                                    .name(name)
                                    .arguments(arguments)
                                    .build());
    cli.print(pretty(result.resultText()));
}

switch (options.getRequiredOption("action")) {
case "list-tools" -> listTools(options.getOption("regexp").orElse(".*"));
case "call-tool" -> callTool(options.getRequiredOption("name"), options.getOption("arguments").orElse(""));
default -> throw new Exception("'action' is not recognized");
}


